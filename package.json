{
  "name": "bookly-ph-native",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:expo": "cd apps/expo && npm run start",
    "dev:next": "cd apps/next && npm run dev",
